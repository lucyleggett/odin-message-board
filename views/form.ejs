<form method="POST" action="/new">
  <label for="name-input" class="sr-only">Your name</label>
  <input name="nameInput" type="text" id="name-input" placeholder="Your name" required="true" />

  <label for="message-input" class="sr-only">Your message</label>
  <textarea
    name="messageInput"
    id="message-input"
    rows="4"
    placeholder="Your message"
    required="true"
  ></textarea>

  <label for="theme-color">Choose a color:</label>
  <input name="themeColor" type="color" id="theme-color" value="#ff0000" />

  <button type="submit">Submit</button>
</form>
